// Late Founders Command Center data model.
//
// One member record per user (ProfileField rows keyed by field name). Every
// asset reads and writes that record; nothing an asset produces lives only in
// its own state. JSON is stored as text so the schema runs on SQLite locally
// and on Postgres in production without changes beyond the provider line.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String // first name, used in greetings
  lastName      String    @default("")
  passwordHash  String
  role          String    @default("member") // member | admin; admins are added by another admin, never at sign-up
  disabled      Boolean   @default(false) // turned off by an admin: cannot log in
  lastSeenAt    DateTime? // refreshed at most hourly while they use the app
  noticesSeenAt DateTime? // when they last opened Notifications; newer notices light the bell
  createdAt     DateTime  @default(now())

  sessions      Session[]
  resets        PasswordReset[]
  profileFields ProfileField[]
  assetStates   AssetState[]
  versions      AssetVersion[]
  messages      Message[]
  sops          Sop[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time password reset links. Only a hash of the token is stored, so a
// database leak can't be turned into working reset links.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// The member record. key is a field name from src/content/profile.ts.
model ProfileField {
  id        String   @id @default(cuid())
  userId    String
  key       String
  valueJson String
  source    String // asset id that last wrote it, or "member"
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Live, autosaved working state of one asset for one member.
model AssetState {
  id          String    @id @default(cuid())
  userId      String
  assetId     String
  dataJson    String    @default("{}")
  status      String    @default("not_started") // not_started | in_progress | complete
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
}

// Immutable snapshot taken on every completion or re-run. Nothing is lost on re-run.
model AssetVersion {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  version   Int
  dataJson  String // the inputs or AI output that produced this version
  docJson   String // RenderDoc used for PDF/DOCX/XLSX downloads
  label     String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId, version])
  @@index([userId, createdAt])
}

// Assistant conversation turns. contentJson holds the exact API content blocks
// (including thinking blocks) so history is replayed append-only; text is the
// member-visible rendering.
model Message {
  id          String   @id @default(cuid())
  userId      String
  assetId     String
  run         Int      @default(1) // a fresh run starts a new conversation; old runs stay readable
  role        String // user | assistant | system (member-record injections)
  contentJson String
  text        String
  hidden      Boolean  @default(false) // tool round-trips the member never sees
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assetId, run, createdAt])
  @@index([userId, createdAt]) // daily Assistant cap
}

// SOP Library (Course 12). Each change creates a new SopVersion.
model Sop {
  id         String       @id @default(cuid())
  userId     String
  role       String
  title      String
  owner      String       @default("")
  nextReview DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions   SopVersion[]

  @@index([userId, role])
}

model SopVersion {
  id          String   @id @default(cuid())
  sopId       String
  version     Int
  contentJson String // { steps: [{what, why}], exceptions: [{when, do}], purpose }
  notes       String   @default("")
  createdAt   DateTime @default(now())
  sop         Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@unique([sopId, version])
}

// Courses the team builds in the Admin area, shown after the built-in ones.
model Course {
  id        String   @id @default(cuid())
  title     String
  pillar    String   @default("")
  summary   String   @default("")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Anything the team adds for members: a file (stored here, up to 4 MB), a link
// or a short note. courseKey is "c3" for built-in Course 03, a Course id for a
// team-built course, or "" for the general Resources library.
model Material {
  id          String   @id @default(cuid())
  courseKey   String   @default("")
  place       String   @default("") // built-in courses: "top", a tool's asset id (shown right after it), or "" for the end
  title       String
  description String   @default("")
  kind        String // file | link | note
  url         String   @default("")
  body        String   @default("")
  fileName    String   @default("")
  mimeType    String   @default("")
  data        Bytes?
  sizeBytes   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([courseKey, createdAt])
}

// Announcements from the team to every member (the notification bell).
model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  link      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
