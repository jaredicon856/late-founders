{
  "name": "late-founders-command-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "npm run fonts && prisma generate && node scripts/db-sync.mjs && tsc --noEmit && vitest run && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "fonts": "node scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@expo-google-fonts/montserrat": "^0.4.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
