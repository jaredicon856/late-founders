# Copy to .env and fill in. Never commit the real file.

# Supabase Postgres. In Supabase: Project Settings > Database > Connection string.
# DATABASE_URL: the Transaction pooler string (port 6543), with
#   ?pgbouncer=true&connection_limit=1 appended.
# DIRECT_URL: the Session pooler string (port 5432).
DATABASE_URL=""
DIRECT_URL=""

# Claude API key from console.anthropic.com. Without it, AI apps reply with a
# "not configured" notice instead of calling Claude.
ANTHROPIC_API_KEY=""

# Model for the Assistant. Opus 5.5 is the default; claude-sonnet-5-5 costs half.
ANTHROPIC_MODEL="claude-opus-5-5"

# Optional: trademark search for the Availability-Sweep Agent. Without it the
# trademark column reports "could not complete" and links to the USPTO search.
TRADEMARK_API_URL=""
TRADEMARK_API_KEY=""

# Optional: speech-to-text for the SOP Generator's audio/video uploads.
# Without it, members paste a transcript or upload a .txt/.vtt/.srt file.
TRANSCRIPTION_API_URL=""
TRANSCRIPTION_API_KEY=""

# Members sign up with this code (shared from Skool). Leave empty to allow
# open sign-up, e.g. during testing.
SIGNUP_CODE=""
